# ==============================================================================
# Laporin - .gitignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Kredensial, Secrets & Environment Variables (SANGAT PENTING)
# ------------------------------------------------------------------------------
# Environment variables (.env)
.env
.env.*
*.env
assets/.env
assets/env
!.env.example
!.env.*.example

# Android Keystore & Signing Secrets
*.keystore
*.jks
*.bks
key.properties
**/android/key.properties
**/android/app/key.properties

# Firebase & Google Cloud Credentials / Service Accounts
**/google-services.json
**/android/**/google-services.json
**/GoogleService-Info.plist
**/ios/**/GoogleService-Info.plist
*firebase-adminsdk*.json
*service-account*.json
*service_account*.json
*-credentials.json
*gcp-key*.json
client_secret*.json

# Supabase Local Credentials & State
.supabase/
supabase/.temp/
supabase/.branches/
supabase/.env*

# Sertifikat & Private Keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.der

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
# Node.js / NPM / CLI tools
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Firebase CLI cache & debug logs
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# ------------------------------------------------------------------------------
# 3. Flutter & Dart (Build & Cache)
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.packages
build/
**/build/
coverage/
**/doc/api/
.widget_preview/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# 4. Android Build, Cache & Local SDK Configuration
# ------------------------------------------------------------------------------
**/android/.gradle/
.gradle/
**/android/local.properties
local.properties
**/android/captures/
**/android/.cxx/
**/android/.kotlin/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
GeneratedPluginRegistrant.java
android/build/

# ------------------------------------------------------------------------------
# 5. iOS / macOS Build, Pods & Local Configuration
# ------------------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/flutter_assets/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Pods/
Pods/
**/ios/.symlinks/
.symlinks/
*.ipa
*.mobileprovision
**/DerivedData/
xcuserdata/
**/ios/Runner/GeneratedPluginRegistrant.*

# ------------------------------------------------------------------------------
# 6. IDEs & Editors Configuration
# ------------------------------------------------------------------------------
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# Visual Studio Code
.vscode/

# Editor lainnya
.atom/
.history/
.fleet/
.sublime-*

# ------------------------------------------------------------------------------
# 7. Sistem Operasi & File Sementara
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux / Editor swap
*~
*.swp
*.swo
*.class
*.pyc
*.tmp
*.temp
*.bak
*.log

# Build log / migration temp
.build/
.buildlog/
.svn/
.swiftpm/
migrate_working_dir/
